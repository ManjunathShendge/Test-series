{
  "name": "@exam-prep/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations/sqlite",
    "scripts",
    "seeds"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --incremental false --composite false",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "migrate": "pnpm build && node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "migrate:deploy": "pnpm migrate",
    "seed": "pnpm build && node --env-file-if-exists=../../.env seeds/index.mjs",
    "test:int": "node --env-file-if-exists=../../.env --test test/integration/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "1.93.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
