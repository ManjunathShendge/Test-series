{
  "name": "@exam-prep/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "lint": "oxlint src",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node --experimental-strip-types seeds/index.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "1.93.0"
  }
}
