{
  "name": "exam-prep-marketplace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "pnpm build:server && turbo run dev dev:worker --filter=@exam-prep/api --filter=@exam-prep/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --filter=@exam-prep/api --filter=@exam-prep/db",
    "test:e2e": "pnpm build && node --env-file-if-exists=.env scripts/smoke.mjs",
    "db:migrate": "pnpm --filter @exam-prep/db run migrate:deploy",
    "db:seed": "pnpm --filter @exam-prep/db run seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "build:server": "turbo run build --filter=@exam-prep/api...",
    "db:migrate:dev": "pnpm --filter @exam-prep/db run migrate",
    "services:up": "docker compose up -d --wait postgres",
    "services:stop": "docker compose stop",
    "check:public-env": "node scripts/check-public-env.mjs"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
