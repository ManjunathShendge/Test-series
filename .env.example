NODE_ENV=development
APP_ENV=local
API_PORT=3001
WORKER_PORT=3002
PUBLIC_WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Relative to the workspace root for API, worker and CLI alike.
DATABASE_URL=file:./data/exam-prep.sqlite
# All server storage is SQLite. Provider credentials arrive with integrations.

# Supabase Postgres (staging). Paste from Supabase dashboard > Connect.
# Not read by the app yet: it switches from SQLite to Postgres in the next change.
# Transaction pooler (port 6543): API server.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432): migrations and worker.
SUPABASE_MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
