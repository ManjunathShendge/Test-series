NODE_ENV=development
APP_ENV=local
API_PORT=3001
WORKER_PORT=3002
PUBLIC_WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Local Docker PostgreSQL 17 (pnpm services:up). Public local-only fixtures.
# To change the port, set POSTGRES_PORT and update all three URLs together.
POSTGRES_PORT=15432
# API: row access only. Staging uses the Supabase transaction pooler (6543).
DATABASE_URL=postgresql://exam_app:local_app_only@127.0.0.1:15432/exam_prep
# Worker: row access only. Staging uses the Supabase session pooler (5432).
WORKER_DATABASE_URL=postgresql://exam_worker:local_worker_only@127.0.0.1:15432/exam_prep
# Migrations and seeds: schema owner. Staging uses the Supabase session pooler (5432).
MIGRATION_DATABASE_URL=postgresql://exam_migrator:local_migration_only@127.0.0.1:15432/exam_prep
# Deployed environments only: path to the provider CA certificate; enables verified TLS.
# DATABASE_CA_CERT_PATH=

# Supabase Postgres (staging). Paste from Supabase dashboard > Connect.
# Staging values kept for reference; local runs use the Docker URLs above.
# Transaction pooler (port 6543): API server.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432): migrations and worker.
SUPABASE_MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Written by `pnpm --filter @exam-prep/db provision-roles` (OUTPUT_PREFIX=STAGING_). Never commit real values.
# STAGING_DATABASE_URL=
# STAGING_WORKER_DATABASE_URL=
# STAGING_DATABASE_CA_CERT_PATH=
