# API: the Android emulator uses http://10.0.2.2:3001/v1; a phone on the same Wi-Fi uses
# the computer's LAN address, for example http://192.168.1.19:3001/v1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Firebase web app config (Firebase console > Project settings > Your apps). These identify
# the project and are not secrets. The project id must match the API's FIREBASE_PROJECT_ID.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in (development and store builds only; Expo Go cannot load it). Firebase
# console > Authentication > Sign-in method > Google > Web SDK configuration: Web client ID.
# iOS client ID: CLIENT_ID in GoogleService-Info.plist after adding the iOS app in Firebase.
# Leave empty to keep the Google button disabled.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (read by app.config.ts, never bundled). Bundle ID / Android package;
# Google's OAuth clients are tied to it. Placeholder until the real one is chosen.
APP_BUNDLE_ID=com.testapp.examprep
# REVERSED_CLIENT_ID from GoogleService-Info.plist (com.googleusercontent.apps....).
GOOGLE_IOS_URL_SCHEME=

# Product analytics (PostHog project API key: public, write-only). Empty sends nothing; events
# also need the student's opt-in. Host defaults to https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
