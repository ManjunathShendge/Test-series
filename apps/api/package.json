{
  "name": "@exam-prep/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n tsc,api \"tsc -b --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "dev:worker": "node --env-file-if-exists=../../.env --watch dist/worker.js",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit --incremental false --composite false",
    "lint": "oxlint src",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "node --env-file-if-exists=../../.env --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@exam-prep/contracts": "workspace:*",
    "@exam-prep/db": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "katex": "0.19.1",
    "minio": "8.0.7",
    "nodemailer": "10.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "10.0.7",
    "oxlint": "1.93.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
