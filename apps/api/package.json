{
  "name": "@exam-prep/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "dev:worker": "node --watch --experimental-strip-types src/worker.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@exam-prep/contracts": "workspace:*",
    "@exam-prep/db": "workspace:*",
    "@exam-prep/engine": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "pg-boss": "12.38.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "1.93.0"
  }
}
