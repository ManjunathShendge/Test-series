NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
# Public site address for canonical links, sitemap and structured data (defaults to https://makemeprepare.com).
NEXT_PUBLIC_SITE_URL=
# Firebase web app config (Project settings > Your apps > Web). Public identifiers, not secrets;
# until all four are set, sign-in reports that it is not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Product analytics (PostHog project API key: public, write-only). Empty sends nothing; events
# also need the visitor's opt-in. Host defaults to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
