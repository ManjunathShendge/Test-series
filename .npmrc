# Exact versions only. CLAUDE.md forbids undocumented "latest" dependencies, and the
# prisma package in particular publishes a release candidate under its "latest" tag.
save-exact=true

# Node version is enforced, not suggested. Flip to true once the local Node is >= 22.22.3;
# left false now because the workspace minimum is above the currently installed 22.18.0.
engine-strict=false

# Keep transitive dependencies out of the import graph unless declared.
auto-install-peers=true
strict-peer-dependencies=false
